[Unit]
Description=Agente de notícias de economia mundial
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projetos/economics-news/agente-noticias
EnvironmentFile=%h/.config/agente-noticias/env
ExecStart=%h/projetos/economics-news/agente-noticias/.venv/bin/python -m agente_noticias executar
